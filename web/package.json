{
  "name": "ncm-to-mp3-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-core.mjs && vite --host 127.0.0.1 --port 5173",
    "build": "node scripts/prepare-core.mjs && vite build",
    "build:local": "npm run build && node scripts/package-local.mjs",
    "start": "python3 start.py",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "fflate": "0.8.3",
    "lucide-react": "1.61.0",
    "ncmdump-js": "0.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "vite": "8.3.5"
  }
}
